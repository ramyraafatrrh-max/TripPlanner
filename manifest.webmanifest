{
  "name": "Trip Pilot",
  "short_name": "Trip Pilot",
  "description": "Turn your travel PDFs into a day-by-day plan with maps, progress and morning alerts.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
